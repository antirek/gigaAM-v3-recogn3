# HF token for Sortformer download (optional if model already cached)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Diar streaming config (very high latency = best quality for offline)
DIAR_CHUNK_LEN=340
DIAR_RIGHT_CONTEXT=40
DIAR_FIFO_LEN=40
DIAR_UPDATE_PERIOD=340
DIAR_SPKCACHE_LEN=188

# Postprocess (orchestrator)
MERGE_GAP_SEC=1.2
MIN_SEGMENT_SEC=0.35
# Sortformer is 4-spk. Keep top-2 always; allow 3rd/4th if long enough (transfers).
MAX_SPEAKERS=4
MIN_SPK_SEC=10
MIN_SPK_SHARE=0.06
# GigaAM rejects chunks longer than ~25s; keep margin.
# Long turns are cut on diar pause boundaries (atomics), hard-split only as fallback.
MAX_ASR_SEC=20

# Diarization model (HF id). Preferred: v2.1
DIAR_MODEL=nvidia/diar_streaming_sortformer_4spk-v2.1

# Audio prep: false | highpass | true (highpass+loudnorm)
AUDIO_ENHANCE=highpass
AUDIO_HIGHPASS_HZ=80

# Transfer calls (on by default): draft ASR → cue («переведу»…) + hold → re-diar head/tail.
TRANSFER_SPLIT=1
# TRANSFER_GAP_SEC=8
# TRANSFER_AUDIO_HOLD=1
# TRANSFER_AUDIO_HOLD_SEC=5
# TRANSFER_MARGIN_SEC=15
# TRANSFER_HOLD_WINDOW_SEC=60
# TRANSFER_CONTINUITY=first_new
# TRANSFER_MIN_SPK_SEC=4
# TRANSFER_MIN_SPK_SHARE=0.03
# TRANSFER_GAP_ONLY=0
# TRANSFER_HOLD_ONLY=0
# TRANSFER_CUES=перевед|переключ|соедин|оставайтесь\s+на\s+линии
