# HF token for Sortformer download (optional if model already cached)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Diar streaming config (very high latency = best quality for offline)
DIAR_CHUNK_LEN=340
DIAR_RIGHT_CONTEXT=40
DIAR_FIFO_LEN=40
DIAR_UPDATE_PERIOD=340
DIAR_SPKCACHE_LEN=188

# Postprocess (orchestrator)
MERGE_GAP_SEC=1.2
MIN_SEGMENT_SEC=0.35
MAX_SPEAKERS=2
# GigaAM rejects chunks longer than ~25s; keep margin.
# Long turns are cut on diar pause boundaries (atomics), hard-split only as fallback.
MAX_ASR_SEC=20

# Diarization model (HF id). Preferred: v2.1
DIAR_MODEL=nvidia/diar_streaming_sortformer_4spk-v2.1

# Audio prep: false | highpass | true (highpass+loudnorm)
AUDIO_ENHANCE=highpass
AUDIO_HIGHPASS_HZ=80
